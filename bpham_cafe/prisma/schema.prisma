datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}


model Category {
  id        Int      @id @default(autoincrement())
  category String
}

model Ingredient {
  id        Int      @id @default(autoincrement())
  name String
  source String
  price Int
  unit  String
}


model Orders{
  id Int @id @default(autoincrement())
  orders Json
}
